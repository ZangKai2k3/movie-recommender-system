# Mẫu cấu hình biến môi trường cho Hệ Thống Gợi Ý Phim (HTGoiYPhim)
# Sao chép file này thành .env và điền các giá trị thực tế tương ứng

# Môi trường chạy: development | staging | production
ENVIRONMENT=development

# Khóa bí mật dùng để ký JWT Token (yêu cầu chuỗi ngẫu nhiên tối thiểu 32 ký tự trong production)
JWT_SECRET_KEY=thay_the_bang_chuoi_bi_mat_ngau_nhien_khi_trien_khai_production_32bytes

# Thuật toán ký JWT (mặc định: HS256)
JWT_ALGORITHM=HS256

# Thời gian hết hạn của Access Token (phút, ví dụ: 10080 là 7 ngày)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Đường dẫn kết nối cơ sở dữ liệu (mặc định SQLite cục bộ)
DATABASE_URL=sqlite:///./data/htgoiyphim.db

# Danh sách domain Frontend được phép gọi API (phân tách bởi dấu phẩy, không chứa dấu cách)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Đường dẫn file dữ liệu phim cho mô hình gợi ý
DATA_PATH=data/processed/movies_10000.csv

